{
  "name": "@estatecraft/infra-migrations",
  "version": "1.0.0",
  "description": "Database migrations and infrastructure for EstateCraft",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "migrate": "ts-node src/migrate.ts",
    "migrate:dev": "npx prisma migrate dev",
    "migrate:status": "npx prisma migrate status",
    "seed": "ts-node src/seed.ts",
    "db:reset": "npx prisma migrate reset --force",
    "test": "jest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@estatecraft/shared": "workspace:*",
    "prisma": "^4.12.0",
    "@prisma/client": "^4.12.0",
    "dotenv": "^16.0.0",
    "pg": "^8.9.0",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.6.0",
    "typescript": "^5.0.0",
    "ts-node": "^10.9.0",
    "jest": "^29.0.0",
    "@types/jest": "^29.0.0"
  }
}
